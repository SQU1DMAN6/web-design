<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

<Product
    Id="*"
    Name="FtR Inker"
    Language="1033"
    Version="1.0.0.0"
    Manufacturer="Quan Thai"
    UpgradeCode="5da499e7-668a-4df9-8a69-f1b6310fd334">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of FtR Inker is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="ProductFeature" Title="FtR Inker" Level="1">
        <ComponentRef Id="MainFiles" />
        <ComponentRef Id="RenderFiles" />
        <ComponentRef Id="LibFiles" />
        <ComponentRef Id="AutoStart" />
        <ComponentRef Id="StartMenuShortcut" />
        <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- Icons -->
    <Icon Id="app.ico" SourceFile="..\..\assets\img\InkerLogo.png" />
    <Property Id="ARPPRODUCTICON" Value="app.ico" />

    <!-- Directory Structure -->
    <Directory Id="TARGETDIR" Name="SourceDir">

        <Directory Id="ProgramFiles64Folder">
            <Directory Id="FtRFolder" Name="FtR">
                <Directory Id="INSTALLDIR" Name="Inker">

                    <!-- Main app files -->
                    <Component Id="MainFiles" Guid="cdd3e292-e27f-4d19-8fcf-149ac97727d9">
                        <File Id="MainJS" Source="..\main.js" />
                        <File Id="PreloadJS" Source="..\preload.js" />
                        <File Id="PackageJSON" Source="..\package.json" />
                    </Component>

                    <!-- Renderer -->
                    <Component Id="RenderFiles" Guid="e93d8011-1aba-4d26-94fb-a806a641cec2">
                        <File Id="IndexHTML" Source="..\renderer\index.html" />
                        <File Id="RendererJS" Source="..\renderer\renderer.js" />
                        <File Id="StyleCSS" Source="..\renderer\style.css" />
                    </Component>

                    <!-- Libraries -->
                    <Component Id="LibFiles" Guid="405f972e-2465-4c86-85ef-c7bc85ddccf6">
                        <File Id="ApiClientJS" Source="..\lib\api-client.js" />
                        <File Id="MountManagerJS" Source="..\lib\mount-manager.js" />
                        <File Id="SyncManagerJS" Source="..\lib\sync-manager.js" />
                        <File Id="SettingsJS" Source="..\lib\settings.js" />
                    </Component>

                    <!-- Autostart -->
                    <Component Id="AutoStart" Guid="d8485c12-4c31-440a-b919-5f1fa7ec57b5">
                        <RegistryValue
                            Root="HKCU"
                            Key="Software\Microsoft\Windows\CurrentVersion\Run"
                            Name="FtRInker"
                            Value="&quot;[INSTALLDIR]electron.exe&quot; &quot;[INSTALLDIR]main.js&quot;"
                            Type="string" />
                    </Component>

                </Directory>
            </Directory>
        </Directory>

        <!-- Start Menu -->
        <Directory Id="ProgramMenuFolder">
            <Directory Id="ApplicationProgramsFolder" Name="FtR Inker">

                <Component Id="StartMenuShortcut" Guid="7a6bb7af-9f82-4e4f-8352-d6fa850a9fc3">
                    <Shortcut
                        Id="StartMenuInker"
                        Name="FtR Inker"
                        Description="FtR Inker - InkDrop Desktop Client"
                        Target="[INSTALLDIR]electron.exe"
                        Arguments="[INSTALLDIR]main.js"
                        WorkingDirectory="INSTALLDIR" />

                    <RemoveFolder Id="CleanUpShortcut" Directory="ApplicationProgramsFolder" On="uninstall" />

                    <RegistryValue Root="HKCU" Key="Software\FtR\Inker" Name="Installed" Type="integer" Value="1" />
                </Component>

            </Directory>
        </Directory>

        <!-- Desktop Shortcut -->
        <Directory Id="DesktopFolder">

            <Component Id="DesktopShortcut" Guid="60992b99-8521-4ba2-bf3d-f1de9d27f61c">

                <Shortcut
                    Id="DesktopInker"
                    Name="FtR Inker"
                    Description="FtR Inker - InkDrop Desktop Client"
                    Target="[INSTALLDIR]electron.exe"
                    Arguments="[INSTALLDIR]main.js"
                    WorkingDirectory="INSTALLDIR" />

                <RegistryValue Root="HKCU" Key="Software\FtR\Inker" Name="DesktopShortcut" Type="integer" Value="1" />

            </Component>

        </Directory>

    </Directory>

</Product>
</Wix>